{
  "name": "electron-frame",
  "version": "1.0.0",
  "description": "Electron Frame For Neko",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:ts && npm run build:electron",
    "build:ts": "tsc",
    "build:electron": "electron-builder",
    "dev": "npm run build:ts && electron .",
    "watch:ts": "tsc -w",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "electron": "^22.3.27",
    "electron-builder": "^24.0.0",
    "eslint": "^9.39.1",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.xymh.neko.electron",
    "productName": "Electron Frame For Neko",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "compression": "normal"
  }
}
