{
  "name": "electron-pipe-app",
  "version": "1.0.0",
  "description": "Electron app with anonymous pipe communication",
  "main": "dist/main.js",
  "scripts": {
    "build-main": "tsc -p tsconfig.main.json",
    "build-renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build-main && npm run build-renderer",
    "start": "npm run build && electron dist/main.js",
    "dev": "npm run build && electron dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^25.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}