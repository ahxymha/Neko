{
  "appId": "com.xymh.neko.electron",
  "productName": "Electron Frame For Neko",
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "directories": {
    "output": "dist-electron"
  },
  "extraResources": [
    {
      "from": "dist",
      "to": "app",
      "filter": ["**/*", "!main.js"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  }
}