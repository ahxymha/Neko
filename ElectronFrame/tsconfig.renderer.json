{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [ "DOM", "ES2020", "WebWorker" ],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [ "src/renderer.ts" ],
  "exclude": [ "node_modules", "dist", "src/main.ts", "src/preload.ts" ]
}